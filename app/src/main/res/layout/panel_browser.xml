<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/browserPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/browserTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#101014"
        android:orientation="vertical"
        android:paddingLeft="6dp"
        android:paddingTop="4dp"
        android:paddingRight="6dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBrowserBack"
                style="@style/Btn.Text"
                android:text="←"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnBrowserForward"
                style="@style/Btn.Text"
                android:text="→"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/urlBar"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="Sök eller ange adress…"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/dim"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnGoUrl"
                style="@style/Btn.Text"
                android:text="Gå" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBrowserHome"
                style="@style/Btn.Text"
                android:text="Hem"
                android:textColor="@color/gold_light"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnBrowserRefresh"
                style="@style/Btn.Text"
                android:text="Ladda om"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnHideTopBar"
                style="@style/Btn.Text"
                android:text="Dölj fält ▲"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/browserSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingRight="6dp"
                android:textColor="@color/gold_pale"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnModeControlFromBrowser"
                style="@style/Btn.Text"
                android:text="⚙ Kontroll"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Quick links – filled from MainActivity.QUICK_LINKS -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/quickLinksRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="4dp"
                android:paddingRight="4dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
