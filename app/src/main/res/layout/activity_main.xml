<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/mainColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: title, live status, browser shortcut and STOP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="HISMITH SMART SESSION"
                    android:textColor="@color/gold"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/headerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="v2.1 · Redo"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnModeBrowser"
                style="@style/Btn.Outline"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="0dp"
                android:layout_weight="0"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="Webbläsare"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnEmergency"
                style="@style/Btn.Red"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="0dp"
                android:layout_weight="0"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="STOPP"
                android:visibility="gone" />
        </LinearLayout>

        <!-- STOPPED banner -->
        <TextView
            android:id="@+id/stoppedBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_btn_red"
            android:gravity="center"
            android:padding="10dp"
            android:text="STOPPAD – tryck för att kvittera"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include layout="@layout/tab_session" />

            <include layout="@layout/tab_lube" />

            <include layout="@layout/tab_challenge" />

            <include layout="@layout/tab_remote" />

            <include layout="@layout/tab_recipe" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_tabbar"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabSession"
                style="@style/Tab"
                android:text="◉\nSESSION" />

            <TextView
                android:id="@+id/tabLube"
                style="@style/Tab"
                android:text="💧\nLUBE" />

            <TextView
                android:id="@+id/tabChallenge"
                style="@style/Tab"
                android:text="▦\nUTMANING" />

            <TextView
                android:id="@+id/tabRemote"
                style="@style/Tab"
                android:text="⇄\nLÄNK" />

            <TextView
                android:id="@+id/tabRecipe"
                style="@style/Tab"
                android:text="☰\nRECEPT" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/panel_browser" />

    <!-- Fullscreen video container (covers the browser; the WebView is never hidden) -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Draggable overlay buttons, on top of the browser and fullscreen video -->
    <Button
        android:id="@+id/btnOverlayStop"
        style="@style/Overlay"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="20dp"
        android:alpha="0.92"
        android:background="@drawable/bg_overlay_stop"
        android:text="⋮⋮ STOPP"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnOverlayMega"
        style="@style/Overlay"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:alpha="0.92"
        android:background="@drawable/bg_overlay_gold"
        android:text="⋮⋮ SUPER SPRUT"
        android:textColor="@color/gold_pale" />

    <!-- Mini control panel in the browser: drag by the handle -->
    <LinearLayout
        android:id="@+id/miniPanel"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="80dp"
        android:alpha="0.94"
        android:background="@drawable/bg_overlay_menu"
        android:elevation="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/miniHandle"
            android:layout_width="26dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⋮⋮"
            android:textColor="@color/gold"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/miniSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="42dp"
            android:gravity="center"
            android:text="0 %"
            android:textColor="@color/gold_pale"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/miniMinus"
            style="@style/Btn.Mini"
            android:text="−" />

        <Button
            android:id="@+id/miniPlus"
            style="@style/Btn.Mini"
            android:text="+" />

        <Button
            android:id="@+id/miniBoost"
            style="@style/Btn.Mini"
            android:text="⚡" />

        <Button
            android:id="@+id/miniEdge"
            style="@style/Btn.Mini"
            android:text="🎯" />

        <Button
            android:id="@+id/miniRest"
            style="@style/Btn.Mini"
            android:text="💤" />

        <Button
            android:id="@+id/miniExtra"
            style="@style/Btn.Mini"
            android:text="💧" />

        <Button
            android:id="@+id/miniPause"
            style="@style/Btn.Mini"
            android:text="⏸" />
    </LinearLayout>

    <Button
        android:id="@+id/btnOverlayBarToggle"
        style="@style/Overlay"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:alpha="0.85"
        android:background="@drawable/bg_overlay_menu"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:text="⋮⋮ Meny"
        android:textColor="@color/gold"
        android:textSize="12sp" />
</FrameLayout>
