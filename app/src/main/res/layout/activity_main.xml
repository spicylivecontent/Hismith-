<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08080A">

    <ScrollView
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="HISMITH SMART SESSION"
                        android:textColor="#D4AF37"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Luxury Edition • v1.1.1"
                        android:textColor="#8A8270"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Nödstoppsknappen visas först när en maskin är ansluten och en session körs -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmergency"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:text="STOPP"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="#C92A2A"
                    app:cornerRadius="12dp"
                    app:strokeColor="#E5C158"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Mode Switcher -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="14dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeControl"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Kontrollpanel"
                    android:textColor="#D4AF37"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="#D4AF37"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeBrowser"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Webbläsare"
                    android:textColor="#E5C158"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="#6E5A28"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Devices Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#121216"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="#2E2618"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:paddingBottom="8dp"
                        android:text="ENHETER (FLERA MÖJLIGA)"
                        android:textColor="#D4AF37"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddDevice"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="+ Anslut Bluetooth-enhet"
                        android:textColor="#F3E5AB"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:strokeColor="#D4AF37"
                        app:strokeWidth="1dp" />

                    <TextView
                        android:id="@+id/devicesText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="10dp"
                        android:paddingBottom="4dp"
                        android:text="Inga enheter anslutna (tryck för att koppla från)"
                        android:textColor="#F5F2EB"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="4dp"
                        android:text="Lägg till maskin / pocket / launcher"
                        android:textColor="#A8A296"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Session Configuration Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#121216"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="#2E2618"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:paddingBottom="10dp"
                        android:text="SESSIONSINSTÄLLNINGAR"
                        android:textColor="#D4AF37"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Minsta tid (min)"
                                android:textColor="#A8A296"
                                android:textSize="12sp" />

                            <EditText
                                android:id="@+id/minTimeInput"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="4dp"
                                android:background="#1C1A22"
                                android:gravity="center"
                                android:inputType="number"
                                android:paddingHorizontal="10dp"
                                android:text="20"
                                android:textColor="#F3E5AB"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Max tid (0 = obegr.)"
                                android:textColor="#A8A296"
                                android:textSize="12sp" />

                            <EditText
                                android:id="@+id/maxTimeInput"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="4dp"
                                android:background="#1C1A22"
                                android:gravity="center"
                                android:inputType="number"
                                android:paddingHorizontal="10dp"
                                android:text="45"
                                android:textColor="#F3E5AB"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/autoLubeCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:buttonTint="#D4AF37"
                        android:checked="true"
                        android:text="Aktivera kontinuerlig Auto-Lube"
                        android:textColor="#F5F2EB" />

                    <CheckBox
                        android:id="@+id/smartStrokeCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="#D4AF37"
                        android:checked="false"
                        android:text="Smart slaglängd (elektronisk)"
                        android:textColor="#F5F2EB" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStart"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="10dp"
                        android:text="STARTA SESSION"
                        android:textColor="#0A0A0C"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="#D4AF37"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Live Session Telemetry Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#121216"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="#2E2618"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/timeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="00:00"
                        android:textColor="#F3E5AB"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/phaseText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:letterSpacing="0.06"
                        android:text="Redo"
                        android:textColor="#A8A296"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/speedText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="4dp"
                        android:text="0 %"
                        android:textColor="#D4AF37"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        android:progress="0"
                        android:progressBackgroundTint="#2A261E"
                        android:progressTint="#D4AF37" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSpray"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="Extra Sprut"
                            android:textColor="#F3E5AB"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:strokeColor="#D4AF37"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMegaInControl"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="SUPER SPRUT"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            app:backgroundTint="#8A1C1C"
                            app:cornerRadius="12dp"
                            app:strokeColor="#D4AF37"
                            app:strokeWidth="1dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEndSession"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:text="Avsluta session"
                        android:textColor="#A8A296"
                        app:cornerRadius="12dp"
                        app:strokeColor="#3D3526" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Built-in Browser Panel -->
    <LinearLayout
        android:id="@+id/browserPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/browserTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#101014"
            android:orientation="vertical"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBrowserBack"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="←"
                    android:textColor="#D4AF37"
                    android:textSize="18sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBrowserForward"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="→"
                    android:textColor="#D4AF37"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/urlBar"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="#1C1A22"
                    android:hint="Sök eller ange adress…"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:paddingHorizontal="10dp"
                    android:singleLine="true"
                    android:textColor="#F5F2EB"
                    android:textColorHint="#6E685C"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoUrl"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:text="Gå"
                    android:textColor="#D4AF37"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBrowserHome"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="Hem"
                    android:textColor="#E5C158"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBrowserRefresh"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="Ladda om"
                    android:textColor="#A8A296"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHideTopBar"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="Dölj fält ▲"
                    android:textColor="#A8A296"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeControlFromBrowser"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="⚙ Kontroll"
                    android:textColor="#D4AF37"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Fullscreen Video Container (landscape + immersive) -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Draggable Floating Overlay Buttons (stay on top in browser & fullscreen video).
         STOPP / SUPER SPRUT are only shown while a machine is connected and a session is
         running (see MainActivity.refreshSessionControls). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOverlayStop"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="20dp"
        android:alpha="0.90"
        android:elevation="24dp"
        android:paddingHorizontal="18dp"
        android:text="⋮⋮ STOPP"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="#D9B81D1D"
        app:cornerRadius="24dp"
        app:strokeColor="#D4AF37"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOverlayMega"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:alpha="0.90"
        android:elevation="24dp"
        android:paddingHorizontal="18dp"
        android:text="⋮⋮ SUPER SPRUT"
        android:textColor="#F3E5AB"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="#D91A1610"
        app:cornerRadius="24dp"
        app:strokeColor="#D4AF37"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOverlayBarToggle"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:alpha="0.85"
        android:elevation="24dp"
        android:minWidth="0dp"
        android:paddingHorizontal="14dp"
        android:text="⋮⋮ Meny"
        android:textColor="#D4AF37"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="#CC121216"
        app:cornerRadius="20dp"
        app:strokeColor="#D4AF37"
        app:strokeWidth="1dp" />

</FrameLayout>
