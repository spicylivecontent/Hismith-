<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HismithSession" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/gold</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:colorControlNormal">@color/muted</item>
        <item name="android:colorControlActivated">@color/gold</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/dim</item>
        <item name="android:alertDialogTheme">@style/Dialog.Hismith</item>
    </style>

    <style name="Dialog.Hismith" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>
</resources>
